# Firebase client (public — admin Auth UI)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — never expose to the client)
# From a Firebase service account JSON: project_id, client_email, private_key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste private_key in double quotes. Keep the \n sequences. No trailing comma.
# Example: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Plunk (business booking notifications)
PLUNK_API_KEY=
# Used only until an address is saved in Admin → Settings
BOOKING_NOTIFY_EMAIL=
# Verified sending domain required for real delivery
PLUNK_FROM_EMAIL=
# Force console logging instead of Plunk (defaults to on in development when PLUNK_FROM_EMAIL is empty)
# BOOKING_NOTIFY_CONSOLE=true
# BOOKING_NOTIFY_CONSOLE=false


# Public origin used in customer cancellation emails (server-only configuration)
SITE_URL=https://southeasternelectrical.org
# Optional business contact phone included in cancellation emails
BUSINESS_PHONE=
